{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageProvider": {
    "Provider": "Local"
  },
  "Cloudflare": {
    "AccountId": "",
    "AccountHash": "",
    "ApiToken": "",
    "Variant": "public",
    "ApiBaseUrl": "https://api.cloudflare.com/client/v4/"
  },
  "LocalImages": {
    "Root": ".local-data/images",
    "PublicPathPrefix": "/local-images"
  },
  "ImageValidation": {
    "MaxImageSizeBytes": 10485760,
    "MaxPathLength": 1024,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "image/svg+xml"
    ]
  },
  "Security": {
    "ServiceApiKey": ""
  }
}
